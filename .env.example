# ===== 面板登录 =====
ADMIN_USER=admin
ADMIN_PASS=在这里设置一个强密码
# Flask 会话密钥（随机一长串，泄漏会导致会话可伪造）
SECRET_KEY=请用openssl-rand-hex-32生成

# 站点显示名称
SITE_NAME=Homing

# 容器内运行用户。部署前让 ./data 归属相同 UID/GID。
PUID=10001
PGID=10001
IMAGE_TAG=local

# 仅用于短期迁移；默认关闭，避免凭据出现在 URL 和访问日志中。
LEGACY_CERT_QUERY_AUTH=false
ALLOW_LEGACY_CERT_KEY=false
ALLOW_LEGACY_UPDATE_QUERY=false

# ===== Cloudflare =====
# Zone.DNS 编辑权限的 API Token（只存这里）
CF_API_TOKEN=
# 默认 zone（可留空自动从主机名推断，支持多域名）
CF_ZONE_NAME=227755.xyz
